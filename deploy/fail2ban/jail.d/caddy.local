# ===========================================================================
# Fail2ban Caddy Jails for Docker Environment
# Drops abusive and scanning clients in DOCKER-USER iptables chain
# ===========================================================================

[DEFAULT]
banaction = iptables-multiport[chain=DOCKER-USER]

[caddy-abuse]
enabled  = true
filter   = caddy-abuse
logpath  = /var/log/caddy/*.access.log
backend  = auto
maxretry = 5
findtime = 600
bantime  = 3600
port     = 80,443

[caddy-scan]
enabled  = true
filter   = caddy-scan
logpath  = /var/log/caddy/*.access.log
backend  = auto
maxretry = 2
findtime = 3600
bantime  = 86400
port     = 80,443
