# Site: Fanvil Partner (fanvilpartner.com)
# ---------------------------------------------------------------------------
fanvilpartner.com, www.fanvilpartner.com {
  # Security Headers
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    -Server
  }

  # Rate Limiting via caddy-ratelimit (IP-based)
  rate_limit {
    zone leads_fvl {
      key {remote_host}
      events 10
      window 1m
      match {
        path /api/leads
        method POST
      }
    }
    zone global_fvl {
      key {remote_host}
      events 300
      window 1m
    }
  }

  # Reverse Proxy: Unified Lead API (2 replicas via Docker internal DNS round-robin)
  handle /api/* {
    reverse_proxy lead-api:3000 {
      header_up Host {host}
      header_up X-Real-IP {remote_host}
      header_up X-Forwarded-For {remote_host}
      header_up X-Forwarded-Proto {scheme}
    }
  }

  # Reverse Proxy: Unified Admin SPA (IP allowlist enforced by lead-api)
  handle /admin* {
    reverse_proxy lead-api:3000 {
      header_up Host {host}
      header_up X-Real-IP {remote_host}
      header_up X-Forwarded-For {remote_host}
      header_up X-Forwarded-Proto {scheme}
    }
  }

  # Static Website Frontend
  handle {
    root * /srv/sites/fanvilpartner.com
    file_server
    try_files {path} {path}/ /index.html
  }

  # Access Logs
  log {
    output file /var/log/caddy/fanvilpartner.com.access.log {
      roll_size 50mb
      roll_keep 10
    }
    format json
  }
}

