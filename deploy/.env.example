# ===========================================================================
# Tescom Multi-Site Lead Platform - Ortam Değişkenleri Şablonu (.env)
# ===========================================================================
# Bu dosyayı .env adıyla kopyalayın ve gizli değerleri doldurun:
# cp deploy/.env.example deploy/.env

# 1. Otomatik SSL (Let's Encrypt / Caddy)
ACME_EMAIL=destek@tescom.com.tr

# 2. Oturum Güvenliği (En az 32 karakter, rastgele üretilmiş olmalı)
# Üretmek için: openssl rand -hex 32
SESSION_SECRET=GENERATE_WITH_OPENSSL_RAND_HEX_32

# 3. SMTP Şifrelerini Saklamak İçin AES-256-GCM Şifreleme Anahtarı
# Tam olarak 64 karakterlik 32-byte hex olmalı.
# Üretmek için: openssl rand -hex 32
SETTINGS_ENC_KEY=GENERATE_64_CHAR_HEX_KEY_WITH_OPENSSL_RAND_HEX_32

# 4. MongoDB Kimlik Bilgileri
MONGO_ROOT_USER=tescom_root
MONGO_ROOT_PASSWORD=GENERATE_STRONG_ROOT_PASSWORD
MONGO_APP_USER=tescom_app
MONGO_APP_PASSWORD=GENERATE_STRONG_APP_PASSWORD

# 5. Admin Paneli İlk İzinli IP Adresleri (Virgülle ayrılmış IPv4/IPv6 veya CIDR)
# Örnek: ADMIN_BOOTSTRAP_IPS=88.247.12.34,88.247.12.0/24
ADMIN_BOOTSTRAP_IPS=

# 6. Cloudflare Turnstile Bot Koruması
# Cloudflare Dashboard > Turnstile bölümünden alınan Secret Key (0x4AAAAAA...)
# Boş bırakılırsa Turnstile doğrulaması atlanır (captchaStatus="disabled").
TURNSTILE_SECRET_KEY=
